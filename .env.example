# Credenciales de Twilio (Console > Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_aqui

# Número de WhatsApp del que escribe el bot.
# Sandbox de pruebas: whatsapp:+14155238886
# Producción (tu propio número aprobado): whatsapp:+503XXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Números de teléfono de los administradores (separados por coma),
# con código de país. Ej: +50370001111,+50370002222
ADMIN_PHONES=+50370001111

# Zona horaria de la congregación (formato IANA)
TIMEZONE=America/El_Salvador

# Día y hora de la reunión entre semana (0=lunes ... 6=domingo)
MIDWEEK_DAY=3
MIDWEEK_HOUR=19
MIDWEEK_MINUTE=0

# Día y hora de la reunión de fin de semana
WEEKEND_DAY=6
WEEKEND_HOUR=10
WEEKEND_MINUTE=0

# Con cuántos días de anticipación enviar el primer recordatorio
REMINDER_DAYS_BEFORE=2

# Content SID (HXxxxx...) de las plantillas de WhatsApp aprobadas por Meta,
# creadas en Twilio > Content Template Builder. Déjalas vacías mientras
# esperas la aprobación; el bot seguirá funcionando con texto libre para
# quien te haya escrito en las últimas 24h.
CONTENT_SID_PREVIO=
CONTENT_SID_DIA=

# Ruta del archivo SQLite. En Railway, monta un Volume y apunta esto
# a su punto de montaje (ej. /data/congregacion.db) para que el programa
# cargado no se pierda en cada deploy.
DB_PATH=congregacion.db
