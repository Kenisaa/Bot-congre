# Token que te da @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# IDs de Telegram de los administradores (separados por coma).
# Para saber tu ID, escríbele a @userinfobot en Telegram.
ADMIN_IDS=111111111,222222222

# ID del grupo/canal de la congregación donde se publica el programa
# (opcional; puede quedar vacío si solo usarás recordatorios por DM)
GROUP_CHAT_ID=

# Zona horaria de la congregación (formato IANA)
TIMEZONE=America/Santo_Domingo

# Día y hora de la reunión entre semana (0=lunes ... 6=domingo)
MIDWEEK_DAY=2
MIDWEEK_HOUR=19
MIDWEEK_MINUTE=0

# Día y hora de la reunión de fin de semana
WEEKEND_DAY=6
WEEKEND_HOUR=10
WEEKEND_MINUTE=0

# Con cuántos días de anticipación enviar el primer recordatorio
REMINDER_DAYS_BEFORE=2

# Ruta del archivo SQLite. En Railway, monta un Volume y apunta esto
# a su punto de montaje (ej. /data/congregacion.db) para que el programa
# cargado no se pierda en cada deploy.
DB_PATH=congregacion.db
